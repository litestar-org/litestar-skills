# Default: all text files use LF regardless of checkout OS
* text=auto eol=lf

# Shell, PowerShell, and Markdown files must use LF line endings across platforms
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf

# Binary files (explicit for safety)
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# Generated / lock files — keep as-is, never convert
*.lock binary
uv.lock binary
